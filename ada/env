# ada-wsl profile for samcloud-services / model-gateway (#861).
#
# Read as `EnvironmentFile=` by the systemd unit, or sourced by run.sh.
# Values NOT listed here take ollama/config.py's defaults, which target the
# production registry already. Everything here is either an identity or a
# number measured on this box.
#
# THERE IS NO SC_TOKEN IN THIS FILE AND THERE MUST NEVER BE ONE. The bearer is
# read from a 0600 file by the process itself (#845). An earlier version of
# this profile did `set -a` around it and exported SC_TOKEN, which put the
# token in the environment of every child the gateway spawns — visible to any
# reader of that uid through `ps eww`.

# --- identity ---------------------------------------------------------------
SC_DEVICE=ada-wsl
SC_SERVICE_NAME=model-gateway
SC_RESOURCE_ID=ada-wsl/gpu-0

# The gateway's OWN identity: agent `ada-model-service`, scopes exactly
# ["device:ada-wsl"]. Not the seat's ~/.samcloud/token, and not the old
# `service:self` service token, which could not lease at all — every lease
# request 404'd for months because `service:` scopes grant no device
# visibility, and `_request_lease` swallows the error and loads anyway, so
# the box looked healthy the whole time (#861).
SC_TOKEN_FILE=/home/phoria/.config/samcloud-services/ada-model-service.token

# What the gateway demands of CALLERS. A different question from the line
# above, and the split slice and wafer already run: the gateway's own identity
# is as narrow as possible; who may ask it for a model is a group.
SC_REQUIRED_SCOPE=group:services

# --- the device -------------------------------------------------------------
# Declared rather than detected. Detection would get it right here, but every
# other identity on this service is declared and a box that has nvidia-smi
# installed should be able to say it serves from somewhere else.
SC_CAPACITY_BACKEND=cuda
SC_CUDA_INDEX=0

# --- the work gate ----------------------------------------------------------
# ada is a WORK MACHINE. Windows-side renders (Unreal, on the `Phoria - RN02`
# account) hold VRAM this gateway never allocated and holds no lease on, and
# `nvidia-smi memory.used` inside WSL counts them at full size — measured
# 2026-09-29 against the Windows-side counter: UnrealEditor pid 15240 at
# 46,331 MB dedicated, against 46,207-47,954 read from inside WSL.
#
# FOREIGN_IDLE_MB is device memory in use when nobody is working. Two idle
# measurements disagree: 3,118 MB median over 31 samples at 5s (claude-ada,
# 23:21-23:23 UTC, spread only 116 MB) and a single 5,515 MB sample 25 minutes
# earlier (samclaude-admin). The HIGHER is set here, and the reason is that
# the gap changes no verdict: a render reads ~46,000 MB, so anything in
# 3,118-5,515 plus the margin separates the two states unambiguously. Only the
# low end can fail invisibly — a floor under the true idle level withdraws
# this node's offer permanently while looking conservative.
#
# SETTING THIS IS WHAT TURNS THE WORK GATE ON. It has no default; slice and
# wafer leave it unset and behave exactly as before. Re-measure at another
# time of day before treating 5,515 as settled.
FOREIGN_IDLE_MB=5515
FOREIGN_MARGIN_MB=1024

# Backstop under the gate above. It was derived from one render — 2,963 MB was
# the maximum free memory observed at any point across 53 samples of one
# continuous 46 GB Unreal session (claude-ada), minimum 188 MB — and rounded up
# to the next hundred, so that the fit check alone could not offer anything at
# any moment of THAT render.
#
# THAT DERIVATION IS ALREADY OUT OF DATE, and the number is kept anyway. Read
# on before changing it.
#
# Measured live on ada 2026-09-29, C1's first hour, mid-render:
#
#     available_mb 5064   usable_mb 2064   device_inuse_mb 44076
#     foreign_mb 44076    work_in_progress TRUE
#
# 5,064 MB free is ABOVE the 2,963 this floor was sized to clear, so
# usable(0.9, 3000) = min(4557, 2064) = 2064 — the floor did NOT bring the
# offer to zero, and the fit check alone would have offered 2 GB into a live
# 44 GB render. (On the Metal default of 1024 it would have offered 4 GB.)
# What actually refused every model was `work_in_progress`, from foreign_mb.
#
# So renders on ada do not all leave the same free memory: a second shape
# appeared within hours of the first one's constant being written. The lesson
# is NOT to raise the floor to chase it (claude-wafer-services). Free memory
# during a render has now been seen anywhere from 188 to 5,064 MB, so no
# ceiling on it separates render from idle reliably — the number that
# generalises is `foreign_mb`, which read 44,076 against an idle floor of
# 3,118-5,515. The floor is a backstop for the case where the foreign reading
# is unavailable or wrong; it is not the mechanism, and sizing it as though it
# were would be fitting a constant to one render twice.
#
# Asserted, so this cannot quietly become untrue again: `test_work_gate`
# checks that usable() is 0 at the first render's peak and NONZERO at the
# second's, and that the work gate refuses at both.
SC_MIN_HEADROOM_MB=3000

# --- backends ---------------------------------------------------------------
# No exo node on ada: the pool is two Macs.
EXO_ENABLED=0
# mlx-whisper is Apple-silicon only. (There is deliberately no VLM_ENABLED:
# mlx-vlm is equally Mac-only but needs no switch, because `hf_model_installed`
# finds no weights here, so `offering()` never advertises one and
# `match_vlm_model` never resolves one. A flag to make a Linux box look
# symmetrical on paper would be a knob with nothing behind it.)
WHISPER_ENABLED=0

OLLAMA_BASE=http://localhost:11434
SERVICE_PORT=8800
